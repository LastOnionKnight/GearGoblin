<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Author>LastOnionKnight</Author>
    <Name>Tonberry Tactics</Name>
    <InternalName>GearGoblin</InternalName>
    <AssemblyVersion>1.6.1.0</AssemblyVersion>
    <FileVersion>1.6.1.0</FileVersion>
    <Version>1.6.1.0</Version>
    <InformationalVersion>1.6.1</InformationalVersion>
    <MinimumDalamudVersion>15.0.0</MinimumDalamudVersion>
    <Punchline>BiS planner, Materia Advisor, and round-trip optimizer for FFXIV.</Punchline>
    <Description>In-game half of Tonberry Tactics. Reads equipped gear and current stats, audits materia, compares Etro/XIVGear targets, exports GG-EXPORT:v2 payloads to the web companion, and imports GG-PLAN:v1 recommendations. Shares optimizer and formula logic with GearGoblin.Core.</Description>
    <RepoUrl>https://github.com/LastOnionKnight/GearGoblin</RepoUrl>
    <Tags>gear;bis;materia;etro;xivgear;raid;advisor;tonberry-tactics</Tags>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);external\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
    </Content>
    <None Include="Assets\circle-logo.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\rags-portrait.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\rags-mini.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\lantern-mark.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\about-changelog.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Fonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="external\GearGoblin.Core\GearGoblin.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="*-dropin\**\*.cs" />
    <Compile Remove="**\*-dropin\**\*.cs" />
    <None Remove="*-dropin\**" />
    <None Remove="**\*-dropin\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
  </ItemGroup>

</Project>
